[[16000,"You believe","ءَامَنتُمْ"],[16001,"(is) your chief","لَكَبِيرُكُمُ"],[16002,"taught you","عَلَّمَكُمُ"],[16003,"So surely I will cut off","فَلَأُقَطِّعَنَّ"],[16004,"and surely I will crucify you","وَلَأُصَلِّبَنَّكُمْ"],[16005,"(the) trunks","جُذُوعِ"],[16006,"and surely you will know","وَلَتَعْلَمُنَّ"],[16007,"which of us","أَيُّنَآ"],[16008,"we will prefer you","نُّؤْثِرَكَ"],[16009,"has come to us","جَآءَنَا"],[16010,"and the One Who","وَٱلَّذِى"],[16011,"created us","فَطَرَنَا"],[16012,"So decree","فَٱقْضِ"],[16013,"(are) decreeing","قَاضٍ"],[16014,"you can decree","تَقْضِى"],[16015,"(for) this","هَٰذِهِ"],[16016,"in our Lord","بِرَبِّنَا"],[16017,"that He may forgive","لِيَغْفِرَ"],[16018,"you compelled us","أَكْرَهْتَنَا"],[16019,"(is) Best","خَيْرٌ"],[16020,"and Ever Lasting","وَأَبْقَىٰٓ"],[16021,"(as) a criminal","مُجْرِمًا"],[16022,"live","يَحْيَىٰ"],[16023,"comes to Him","يَأْتِهِۦ"],[16024,"(as) a believer","مُؤْمِنًا"],[16025,"he has done","عَمِلَ"],[16026,"(will be) the ranks","ٱلدَّرَجَٰتُ"],[16027,"to be overtaken","دَرَكًا"],[16028,"being afraid","تَخْشَىٰ"],[16029,"Then followed them","فَأَتْبَعَهُمْ"],[16030,"with his forces","بِجُنُودِهِۦ"],[16031,"but covered them","فَغَشِيَهُم"],[16032,"covered them","غَشِيَهُمْ"],[16033,"And led astray","وَأَضَلَّ"],[16034,"We delivered you","أَنجَيْنَٰكُم"],[16035,"and We made a covenant with you","وَوَٰعَدْنَٰكُمْ"],[16036,"the Manna","ٱلْمَنَّ"],[16037,"lest should descend","فَيَحِلَّ"],[16038,"he (has) perished","هَوَىٰ"],[16039,"But indeed, I Am","وَإِنِّى"],[16040,"the Perpetual Forgiver","لَغَفَّارٌ"],[16041,"remains guided","ٱهْتَدَىٰ"],[16042,"made you hasten","أَعْجَلَكَ"],[16043,"(are) close","أُو۟لَآءِ"],[16044,"my tracks","أَثَرِى"],[16045,"and I hastened","وَعَجِلْتُ"],[16046,"that You be pleased","لِتَرْضَىٰ"],[16047,"But indeed, We","فَإِنَّا"],[16048,"We (have) tried","فَتَنَّا"],[16049,"and has led them astray","وَأَضَلَّهُمُ"],[16050,"(and) sorrowful","أَسِفًا"],[16051,"promise