[[13500,"(from) the measure","ٱلْمِكْيَالَ"],[13501,"and the scale","وَٱلْمِيزَانَ"],[13502,"in prosperity","بِخَيْرٍ"],[13503,"but indeed, I","وَإِنِّىٓ"],[13504,"all-encompassing","مُّحِيطٍ"],[13505,"and weight","وَٱلْمِيزَانَ"],[13506,"(What) remains","بَقِيَّتُ"],[13507,"Does your prayer","أَصَلَوٰتُكَ"],[13508,"command you","تَأْمُرُكَ"],[13509,"we leave","نَّتْرُكَ"],[13510,"we do","نَّفْعَلَ"],[13511,"our wealth","أَمْوَٰلِنَا"],[13512,"Indeed you","إِنَّكَ"],[13513,"(are) the forbearing","ٱلْحَلِيمُ"],[13514,"the right-minded","ٱلرَّشِيدُ"],[13515,"and He has provided me","وَرَزَقَنِى"],[13516,"I differ from you","أُخَالِفَكُمْ"],[13517,"I forbid you","أَنْهَىٰكُمْ"],[13518,"the reform","ٱلْإِصْلَٰحَ"],[13519,"(is) my success","تَوْفِيقِىٓ"],[13520,"I trust","تَوَكَّلْتُ"],[13521,"my dissension","شِقَاقِىٓ"],[13522,"befell","أَصَابَ"],[13523,"(is) Most Merciful","رَحِيمٌ"],[13524,"Most Loving","وَدُودٌ"],[13525,"we understand","نَفْقَهُ"],[13526,"surely [we] see you","لَنَرَىٰكَ"],[13527,"for your family","رَهْطُكَ"],[13528,"surely we would have stoned you","لَرَجَمْنَٰكَ"],[13529,"Is my family","أَرَهْطِىٓ"],[13530,"And you have taken Him","وَٱتَّخَذْتُمُوهُ"],[13531,"behind your","وَرَآءَكُمْ"],[13532,"backs","ظِهْرِيًّا"],[13533,"(that will) disgrace him","يُخْزِيهِ"],[13534,"And watch","وَٱرْتَقِبُوٓا۟"],[13535,"a watcher","رَقِيبٌ"],[13536,"with Madyan","لِّمَدْيَنَ"],[13537,"was taken away","بَعِدَتْ"],[13538,"the Thamud","ثَمُودُ"],[13539,"but they followed","فَٱتَّبَعُوٓا۟"],[13540,"was right","بِرَشِيدٍ"],[13541,"He will precede","يَقْدُمُ"],[13542,"and lead them","فَأَوْرَدَهُمُ"],[13543,"(into) the Fire","ٱلنَّارَ"],[13544,"(is) the place","ٱلْوِرْدُ"],[13545,"to which (they are) led","ٱلْمَوْرُودُ"],[13546,"(by) a curse","لَعْنَةً"],[13547,"(is) the gift","ٱلرِّفْدُ"],[13548,"which (will) be given","ٱلْمَرْفُودُ"],[13549,"(which) We relate","نَقُصُّهُۥ"],[13550,"some are standing","قَآئِمٌ"],[13551,"and (some) mown","وَحَصِيدٌ"],[13552,"they in