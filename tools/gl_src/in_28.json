 working","عَٰمِلُونَ"],[13605,"And wait","وَٱنتَظِرُوٓا۟"],[13606,"(are) ones who wait","مُنتَظِرُونَ"],[13607,"of the narrations","ٱلْقَصَصِ"],[13608,"the unaware","ٱلْغَٰفِلِينَ"],[13609,"I saw","رَأَيْتُ"],[13610,"stars","كَوْكَبًا"],[13611,"I saw them","رَأَيْتُهُمْ"],[13612,"your vision","رُءْيَاكَ"],[13613,"lest they plan","فَيَكِيدُوا۟"],[13614,"(is) to man","لِلْإِنسَٰنِ"],[13615,"will choose you","يَجْتَبِيكَ"],[13616,"and will teach you","وَيُعَلِّمُكَ"],[13617,"(the) interpretation","تَأْوِيلِ"],[13618,"(of) the narratives","ٱلْأَحَادِيثِ"],[13619,"He completed it","أَتَمَّهَا"],[13620,"your two forefathers","أَبَوَيْكَ"],[13621,"and his brothers","وَإِخْوَتِهِۦٓ"],[13622,"Surely Yusuf","لَيُوسُفُ"],[13623,"than we","مِنَّا"],[13624,"so will be free","يَخْلُ"],[13625,"and you will be","وَتَكُونُوا۟"],[13626,"but throw him","وَأَلْقُوهُ"],[13627,"the bottom","غَيَٰبَتِ"],[13628,"will pick him","يَلْتَقِطْهُ"],[13629,"[the] caravan","ٱلسَّيَّارَةِ"],[13630,"(do) you","لَكَ"],[13631,"trust us","تَأْمَ۫نَّا"],[13632,"while indeed, we","وَإِنَّا"],[13633,"(are) for him","لَهُۥ"],[13634,"surely well-wishers","لَنَٰصِحُونَ"],[13635,"Send him","أَرْسِلْهُ"],[13636,"(to) enjoy","يَرْتَعْ"],[13637,"it surely saddens me","لَيَحْزُنُنِىٓ"],[13638,"would eat him","يَأْكُلَهُ"],[13639,"a wolf","ٱلذِّئْبُ"],[13640,"eats him","أَكَلَهُ"],[13641,"surely (would be) losers","لَّخَٰسِرُونَ"],[13642,"and agreed","وَأَجْمَعُوٓا۟"],[13643,"they put him","يَجْعَلُوهُ"],[13644,"But We inspired","وَأَوْحَيْنَآ"],[13645,"Surely, you will inform them","لَتُنَبِّئَنَّهُم"],[13646,"And they came","وَجَآءُوٓ"],[13647,"(to) their father","أَبَاهُمْ"],[13648,"early at night","عِشَآءً"],[13649,"[we] went","ذَهَبْنَا"],[13650,"racing each other","نَسْتَبِقُ"],[13651,"and we left","وَتَرَكْنَا"],[13652,"our possessions","مَتَٰعِنَا"],[13653,"and ate him","فَأَكَلَهُ"],[13654,"(will) believe","بِمُؤْمِنٍ"],[13655,"And they brought","وَجَآءُو"],[13656,"(to) a matter","أَمْرًا"],[13657,"(