ired","فَأَوْحَيْنَآ"],[17420,"So it parted","فَٱنفَلَقَ"],[17421,"like the mountain","كَٱلطَّوْدِ"],[17422,"And We brought near","وَأَزْلَفْنَا"],[17423,"We worship","نَعْبُدُ"],[17424,"so we will remain","فَنَظَلُّ"],[17425,"they hear you","يَسْمَعُونَكُمْ"],[17426,"(do) they benefit you","يَنفَعُونَكُمْ"],[17427,"they harm (you)","يَضُرُّونَ"],[17428,"but we found","وَجَدْنَآ"],[17429,"like that ","كَذَٰلِكَ"],[17430,"guides me","يَهْدِينِ"],[17431,"gives me food","يُطْعِمُنِى"],[17432,"and gives me drink","وَيَسْقِينِ"],[17433,"I am ill","مَرِضْتُ"],[17434,"cures me","يَشْفِينِ"],[17435,"will cause me to die","يُمِيتُنِى"],[17436,"he will give me life","يُحْيِينِ"],[17437,"And the One Who ","وَٱلَّذِىٓ"],[17438,"I hope","أَطْمَعُ"],[17439,"my faults","خَطِيٓـَٔتِى"],[17440,"And grant","وَٱجْعَل"],[17441,"the later (generations)","ٱلْءَاخِرِينَ"],[17442,"And make me","وَٱجْعَلْنِى"],[17443,"(the) inheritors","وَرَثَةِ"],[17444,"(of) Garden(s)","جَنَّةِ"],[17445,"And forgive","وَٱغْفِرْ"],[17446,"those astray","ٱلضَّآلِّينَ"],[17447,"And (will be) brought near","وَأُزْلِفَتِ"],[17448,"And (will be) made manifest","وَبُرِّزَتِ"],[17449,"to the deviators","لِلْغَاوِينَ"],[17450,"they help you","يَنصُرُونَكُمْ"],[17451,"Then they will be overturned","فَكُبْكِبُوا۟"],[17452,"and the deviators","وَٱلْغَاوُۥنَ"],[17453,"And (the) hosts","وَجُنُودُ"],[17454,"(of) Iblis","إِبْلِيسَ"],[17455,"(are) disputing","يَخْتَصِمُونَ"],[17456,"we equated you","نُسَوِّيكُم"],[17457,"with (the) Lord","بِرَبِّ"],[17458,"misguided us","أَضَلَّنَآ"],[17459,"So (now) not","فَمَا"],[17460,"then we could be","فَنَكُونَ"],[17461,"surely is a Sign","لَءَايَةً"],[17462,"while followed you","وَٱتَّبَعَكَ"],[17463,"(do) I know","عِلْمِى"],[17464,"the one to drive away","بِطَارِدِ"],[17465,"Surely you will be","لَتَكُونَنَّ"],[17466,"those who are stoned","ٱلْمَرْجُومِينَ"],[17467,"have denied me","كَذَّبُونِ"],[17468,"(with decisive) judgment","فَتْحًا"],[17469,"the remaining ones","ٱلْبَاقِ