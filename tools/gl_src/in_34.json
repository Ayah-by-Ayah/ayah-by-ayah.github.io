ator","وَٱلزَّانِى"],[16911,"[then] flog","فَٱجْلِدُوا۟"],[16912,"(with) hundred","مِا۟ئَةَ"],[16913,"lash(es)","جَلْدَةٍ"],[16914,"withhold you","تَأْخُذْكُم"],[16915,"And let witness","وَلْيَشْهَدْ"],[16916,"their punishment","عَذَابَهُمَا"],[16917,"The fornicator","ٱلزَّانِى"],[16918,"a fornicatress","زَانِيَةً"],[16919,"a polytheist woman","مُشْرِكَةً"],[16920,"and the fornicatress ","وَٱلزَّانِيَةُ"],[16921,"marry her","يَنكِحُهَآ"],[16922,"a fornicator","زَانٍ"],[16923,"a polytheist man","مُشْرِكٌ"],[16924,"And is forbidden","وَحُرِّمَ"],[16925,"then flog them","فَٱجْلِدُوهُمْ"],[16926,"(with) eighty","ثَمَٰنِينَ"],[16927,"lashe(s)","جَلْدَةً"],[16928,"accept","تَقْبَلُوا۟"],[16929,"their","لَهُمْ"],[16930,"and reform","وَأَصْلَحُوا۟"],[16931,"have","يَكُن"],[16932,"then (the) testimony","فَشَهَٰدَةُ"],[16933,"(of) one of them","أَحَدِهِمْ"],[16934,"(is) four","أَرْبَعُ"],[16935,"(be) upon him","عَلَيْهِ"],[16936,"But it would prevent","وَيَدْرَؤُا۟"],[16937,"she bears witness","تَشْهَدَ"],[16938,"(be) upon her","عَلَيْهَآ"],[16939,"(is) Oft-Returning (to Mercy)","تَوَّابٌ"],[16940,"think it","تَحْسَبُوهُ"],[16941,"among them ","مِنْهُمْ"],[16942,"Why (did) not","لَّوْلَا"],[16943,"they brought","يَأْتُوا۟"],[16944,"surely would have touched you","لَمَسَّكُمْ"],[16945,"you had rushed glibly","أَفَضْتُمْ"],[16946,"you received it","تَلَقَّوْنَهُۥ"],[16947,"with your tongues","بِأَلْسِنَتِكُمْ"],[16948,"and you said","وَتَقُولُونَ"],[16949,"with your mouths","بِأَفْوَاهِكُم"],[16950,"and you thought it","وَتَحْسَبُونَهُۥ"],[16951,"(was) insignificant","هَيِّنًا"],[16952,"And why not","وَلَوْلَآ"],[16953,"we speak","نَّتَكَلَّمَ"],[16954,"(is) a slander","بُهْتَٰنٌ"],[16955,"(to the) like of it","لِمِثْلِهِۦٓ"],[16956,"(should) spread","تَشِيعَ"],[16957,"and the evil","وَٱلْمُنكَرِ"],[16958,"(would) have been pure","زَكَىٰ"],[16959,"purifies","يُزَكِّى"],[16960,"let swear","يَأْتَلِ"],[16961,"and the amplitude of means","وَٱلسَّعَةِ"],[16962,"And let them pard