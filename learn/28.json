71,72]},{"madi":"اِهْتَزَّ","mud":"يَهْتَزُّ","amr":"اِهْتَزَّ","masdar":"اِهْتِزَازٌ","fa":"مُهْتِزٌّ","mf":"","mean":"to quiver, to stir","ayahs":[31]},{"madi":"وَلَّى","mud":"يُوَلِّي","amr":"وَلِّ","masdar":"تَوْلِيَةٌ","fa":"مُوَلٍّ","mf":"مُوَلًّى","mean":"to turn (away), to turn (to)","ayahs":[31]},{"madi":"عَقَّبَ","mud":"يُعَقِّبُ","amr":"عَقِّبْ","masdar":"تَعْقِيبٌ","fa":"مُعَقِّبٌ","mf":"","mean":"to turn back, to look back","ayahs":[31]},{"madi":"أَقْبَلَ","mud":"يُقْبِلُ","amr":"أَقْبِلْ","masdar":"إِقْبَالٌ","fa":"مُقْبِلٌ","mf":"","mean":"to approach, to turn toward","ayahs":[31]},{"madi":"سَلَكَ","mud":"يَسْلُكُ","amr":"اُسْلُكْ","masdar":"سُلُوكٌ","fa":"سَالِكٌ","mf":"مَسْلُوكٌ","mean":"to enter, to thread, to cause to enter","ayahs":[32]},{"madi":"ضَمَّ","mud":"يَضُمُّ","amr":"اُضْمُمْ","masdar":"ضَمٌّ","fa":"ضَامٌّ","mf":"مَضْمُومٌ","mean":"to draw close, to press","ayahs":[32]},{"madi":"أَرْسَلَ","mud":"يُرْسِلُ","amr":"أَرْسِلْ","masdar":"إِرْسَالٌ","fa":"مُرْسِلٌ","mf":"مُرْسَلٌ","mean":"to send","ayahs":[34,47]},{"madi":"صَدَّقَ","mud":"يُصَدِّقُ","amr":"صَدِّقْ","masdar":"تَصْدِيقٌ","fa":"مُصَدِّقٌ","mf":"مُصَدَّقٌ","mean":"to confirm, to believe","ayahs":[34]},{"madi":"كَذَّبَ","mud":"يُكَذِّبُ","amr":"كَذِّبْ","masdar":"تَكْذِيبٌ","fa":"مُكَذِّبٌ","mf":"مُكَذَّبٌ","mean":"to deny, to call false","ayahs":[34]},{"madi":"شَدَّ","mud":"يَشُدُّ","amr":"شُدَّ","masdar":"شَدٌّ","fa":"شَادٌّ","mf":"مَشْدُودٌ","mean":"to harden, to bind firmly","ayahs":[35]},{"madi":"وَصَلَ","mud":"يَصِلُ","amr":"صِلْ","masdar":"وَصْلٌ، صِلَةٌ","fa":"وَاصِلٌ","mf":"مَوْصُولٌ","mean":"to join, to connect","ayahs":[35]},{"madi":"ٱتَّبَعَ","mud":"يَتَّبِعُ","amr":"اِتَّبِعْ","masdar":"اِتِّبَاعٌ","fa":"مُتَّبِعٌ","mf":"مُتَّبَعٌ","mean":"to follow","ayahs":[35,47,49,50,57]},{"madi":"سَمِعَ","mud":"يَسْمَعُ","amr":"اِسْمَعْ","masdar":"سَمْعٌ، سَمَاعٌ","fa":"سَامِعٌ","mf":"مَسْمُوعٌ","mean":"to hear","ayahs":[36,55,71]},{"madi":"أَفْلَحَ","mud":"يُفْلِحُ","amr":"أَفْلِح